VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe — get from dashboard.stripe.com
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-payment-link-id
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase service role key — for Netlify webhook function only, never expose client-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Show "Continue with Apple" on the web. Leave unset until the Apple
# Services ID is set up (docs/ios-release.md); iOS shows it regardless.
# VITE_APPLE_WEB_SIGNIN=true
